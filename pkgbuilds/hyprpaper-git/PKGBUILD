# Maintainer: Mason Rhodes <mrhodesdev@gmail.com>

_pkgname=hyprpaper
pkgname=$_pkgname-git
_commit=433a96b40ccd2d923bf45d21d00f394d743934aa
pkgver=0
pkgrel=1
pkgdesc="A blazing fast wayland wallpaper utility with IPC controls"
arch=('x86_64')
url="https://github.com/hyprwm/$_pkgname"
license=('BSD-3-Clause')
depends=(file gcc-libs glibc hyprgraphics-git hyprlang-git hyprtoolkit-git hyprutils-git hyprwire-git pango wayland)
makedepends=(cmake git hyprwayland-scanner-git libglvnd ninja wayland-protocols xorgproto)
provides=("$_pkgname=${pkgver%%.r*}")
conflicts=("$_pkgname")
options=('!debug')
_pkgsrc=$_pkgname
source=("$_pkgsrc::git+$url.git#commit=$_commit")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgsrc"
  local _tag=$(git tag -l --contains $(git describe --tags --abbrev=0) --sort=-v:refname | head -n1 | sed 's/^v//')
  printf "%s.r%s.g%s" "$_tag" $(git rev-list --count --cherry-pick "v${_tag}...HEAD") $(git rev-parse --short=7 HEAD)
}

build() {
  local cmake_options=(
    -B build
    -S "$_pkgsrc"
    -G Ninja
    -W no-dev
    -D CMAKE_BUILD_TYPE=None
    -D CMAKE_INSTALL_PREFIX=/usr
  )
  cmake "${cmake_options[@]}"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$_pkgsrc/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname/"
}
