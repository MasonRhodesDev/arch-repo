# Maintainer: Mason Rhodes <mrhodesdev@gmail.com>

_pkgname=hyprgraphics
pkgname=$_pkgname-git
_commit=344004226bc352ba32d9fc9699ea3cf5d4c90a86
pkgver=0
pkgrel=1
pkgdesc="Hyprland graphics / resource utilities"
arch=('x86_64')
url="https://github.com/hyprwm/$_pkgname"
license=('BSD-3-Clause')
depends=(cairo file gcc-libs glib2 glibc hyprutils-git libgl libheif libjpeg-turbo libjxl libpng librsvg libwebp pango pixman)
makedepends=(cmake git ninja)
provides=("$_pkgname=${pkgver%%.r*}" "lib$_pkgname.so")
conflicts=("$_pkgname")
options=('!debug')
_pkgsrc=$_pkgname
source=("$_pkgsrc::git+$url.git#commit=$_commit")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgsrc"
  git describe --long --tags --abbrev=7 | sed 's/^v//;s/-\([0-9]*\)-g/.r\1.g/'
}

build() {
  local cmake_options=(
    -B build
    -S "$_pkgsrc"
    -G Ninja
    -W no-dev
    -D CMAKE_BUILD_TYPE=None
    -D CMAKE_INSTALL_PREFIX=/usr
  )
  cmake "${cmake_options[@]}"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$_pkgsrc/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname/"
}
