# Maintainer: Mason Rhodes <mrhodesdev@gmail.com>

_pkgname=hypridle
pkgname=$_pkgname-git
_commit=aa958ed7ad4863860b93ecd7189419e193bfae2c
pkgver=0
pkgrel=1
pkgdesc="Hyprland's idle daemon"
arch=('x86_64')
url="https://github.com/hyprwm/$_pkgname"
license=('BSD-3-Clause')
depends=(gcc-libs glibc hyprlang-git hyprutils-git sdbus-cpp systemd wayland)
makedepends=(cmake git hyprland-protocols-git hyprwayland-scanner-git ninja wayland-protocols)
provides=("$_pkgname=${pkgver%%.r*}")
conflicts=("$_pkgname")
options=('!debug')
_pkgsrc=$_pkgname
source=("$_pkgsrc::git+$url.git#commit=$_commit")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgsrc"
  git describe --long --tags --abbrev=7 | sed 's/^v//;s/-\([0-9]*\)-g/.r\1.g/'
}

build() {
  local cmake_options=(
    -B build
    -S "$_pkgsrc"
    -G Ninja
    -W no-dev
    -D CMAKE_BUILD_TYPE=None
    -D CMAKE_INSTALL_PREFIX=/usr
  )
  cmake "${cmake_options[@]}"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$_pkgsrc/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname/"
}
