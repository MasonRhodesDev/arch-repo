pkgname=matugen-bin
pkgver=4.2.0
pkgrel=1
pkgdesc="A material you and base16 color generation tool with templates"
arch=('x86_64')
url="https://github.com/InioX/matugen"
license=('GPL-2.0-or-later')
depends=(gcc-libs glibc)
provides=("matugen=$pkgver")
conflicts=(matugen)
options=('!debug')
source=("$url/releases/download/v$pkgver/matugen-$pkgver-x86_64.tar.gz")
sha256sums=('a2e3b50e49ed6439999ba3c252ed04fabd98ee4e9d12e5e5dff2e66370569751')

package() {
  install -Dm755 matugen -t "$pkgdir/usr/bin"
}
