# Maintainer: Mason Rhodes <mrhodesdev@gmail.com>

_pkgname=hyprpicker
pkgname=$_pkgname-git
_commit=5c451cb4e9d6b1bd2f729d68de8aa114112c7390
pkgver=0
pkgrel=1
pkgdesc="A wlroots-compatible Wayland color picker that does not suck"
arch=('x86_64')
url="https://github.com/hyprwm/$_pkgname"
license=('BSD-3-Clause')
depends=(cairo gcc-libs glibc hyprutils-git libxkbcommon wayland)
makedepends=(cmake git hyprwayland-scanner-git libglvnd libjpeg-turbo ninja pango wayland-protocols xorgproto)
optdepends=(
  'wl-clipboard: --autocopy'
)
provides=("$_pkgname=${pkgver%%.r*}")
conflicts=("$_pkgname")
options=('!debug')
_pkgsrc=$_pkgname
source=("$_pkgsrc::git+$url.git#commit=$_commit")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgsrc"
  local _tag=$(git tag -l --contains $(git describe --tags --abbrev=0) --sort=-v:refname | head -n1 | sed 's/^v//')
  printf "%s.r%s.g%s" "$_tag" $(git rev-list --count --cherry-pick "v${_tag}...HEAD") $(git rev-parse --short=7 HEAD)
}

build() {
  local cmake_options=(
    -B build
    -S "$_pkgsrc"
    -G Ninja
    -W no-dev
    -D CMAKE_BUILD_TYPE=None
    -D CMAKE_INSTALL_PREFIX=/usr
  )
  cmake "${cmake_options[@]}"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$_pkgsrc/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname/"
}
