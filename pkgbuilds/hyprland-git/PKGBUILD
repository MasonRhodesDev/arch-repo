# Maintainer: Mason Rhodes <mrhodesdev@gmail.com>

pkgname=hyprland-git
pkgver=0
pkgrel=1
pkgdesc="Hyprland compositor built from upstream main (lockstep [mason] git channel)"
arch=('x86_64')
url="https://github.com/hyprwm/Hyprland"
license=('BSD-3-Clause')
depends=(aquamarine cairo gcc-libs glib2 glibc glslang hyprcursor hyprgraphics
         hyprland-guiutils hyprlang hyprutils hyprwayland-scanner hyprwire
         lcms2 libcanberra libdisplay-info libdrm libglvnd libinput libliftoff
         libx11 libxcb libxcomposite libxcursor libxfixes libxkbcommon
         libxrender lua mesa muparser opengl-driver pango pixman polkit re2
         sdbus-cpp seatd systemd-libs tomlplusplus util-linux-libs wayland
         wayland-protocols xcb-proto xcb-util xcb-util-errors xcb-util-image
         xcb-util-keysyms xcb-util-renderutil xcb-util-wm xorg-xwayland)
makedepends=('cmake' 'git' 'glaze' 'hyprland-protocols' 'meson' 'ninja' 'xorgproto')
provides=("hyprland" "wayland-compositor")
conflicts=('hyprland')
options=('!debug')
source=("git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd Hyprland
  git describe --long --tags --abbrev=7 | sed 's/^v//;s/-\([0-9]*\)-g/.r\1.g/'
}

prepare() {
  cd Hyprland
  git submodule update --init --recursive
}

build() {
  cd Hyprland
  make release PREFIX=/usr
}

package() {
  provides=("hyprland=${pkgver%%.r*}" "wayland-compositor")
  cd Hyprland
  make PREFIX=/usr DESTDIR="$pkgdir" install
  rm -f "$pkgdir/usr/include/hyprland/src/version.h.in"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
