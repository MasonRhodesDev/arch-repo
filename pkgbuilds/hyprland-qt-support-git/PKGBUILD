# Maintainer: Mason Rhodes <mrhodesdev@gmail.com>

_pkgname=hyprland-qt-support
pkgname=$_pkgname-git
_commit=05a7be67fb3ade62ac6f2b4bd35def316d29134e
pkgver=0
pkgrel=1
pkgdesc="A qml style provider for hypr* qt apps"
arch=('x86_64')
url="https://github.com/hyprwm/$_pkgname"
license=('BSD-3-Clause')
depends=(gcc-libs glibc hyprlang-git qt6-base qt6-declarative qt6-wayland)
makedepends=(cmake git ninja)
provides=("$_pkgname=${pkgver%%.r*}")
conflicts=("$_pkgname")
options=('!debug')
_pkgsrc=$_pkgname
source=("$_pkgsrc::git+$url.git#commit=$_commit")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgsrc"
  local _tag=$(git tag -l --contains $(git describe --tags --abbrev=0) --sort=-v:refname | head -n1 | sed 's/^v//')
  printf "%s.r%s.g%s" "$_tag" $(git rev-list --count --cherry-pick "v${_tag}...HEAD") $(git rev-parse --short=7 HEAD)
}

build() {
  local cmake_options=(
    -B build
    -S "$_pkgsrc"
    -G Ninja
    -W no-dev
    -D CMAKE_BUILD_TYPE=None
    -D CMAKE_INSTALL_PREFIX=/usr
    -D INSTALL_QML_PREFIX=/lib/qt6/qml
    -D CMAKE_INSTALL_LIBDIR=/usr/lib
  )
  cmake "${cmake_options[@]}"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$_pkgsrc/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname/"
}
